# == Base de datos (obligatorio) ==
# Usa cualquier PostgreSQL: local, Vercel Postgres, Neon, Supabase, Railway, etc.
# En Vercel añade esta misma variable como Environment Variable.
DATABASE_URL="postgresql://user:password@localhost:5432/portfolio?schema=public"

# == Backend / Auth ==
JWT_SECRET="cambia-esta-clave-secreta-en-produccion"
ADMIN_EMAIL="admin@arzamendia.dev"
ADMIN_PASSWORD="admin123"

# == Frontend ==
# La API está en el mismo dominio, por eso basta con /api
NEXT_PUBLIC_API_URL=/api

# == Uploads en producción (opcional) ==
# Para subir el CV e imágenes en Vercel. Se genera con: vercel blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
