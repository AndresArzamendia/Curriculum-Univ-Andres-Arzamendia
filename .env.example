# == Base de datos (obligatorio) ==
# Supabase: usa el SESSION pooler (puerto 5432, no 6543) para que DDL/prisma db push funcione desde Vercel
# Copia la URL completa desde Supabase → Project Settings → Database → Connection string (Session pooler)
DATABASE_URL="postgresql://postgres.sg[your-ref]:[YOUR-PASSWORD]@aws-0-[your-region].pooler.supabase.com:5432/postgres?socket_timeout=60&connect_timeout=30"

# == Backend / Auth ==
JWT_SECRET="cambia-esta-clave-secreta-en-produccion"
ADMIN_EMAIL="admin@arzamendia.dev"
ADMIN_PASSWORD="admin123"

# == Frontend ==
# La API está en el mismo dominio, por eso basta con /api
NEXT_PUBLIC_API_URL=/api

# == Uploads en producción (opcional) ==
# Para subir el CV e imágenes en Vercel. Se genera con: vercel blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
